node_modules/

# Cualquier .env queda fuera, salvo la plantilla. El patron es con comodin a
# proposito: `.env` y `.env.local` sueltos dejaban pasar un `.env.vercel` o un
# `.env.produccion` creado despues, que es exactamente donde viven los secretos.
.env*
!.env.example

# Salidas del spike de Places: contienen datos crudos de negocios reales.
# Se revisan a mano, no se versionan.
salidas/
*.log

# Next.js
.next/
next-env.d.ts
tsconfig.tsbuildinfo
*.tsbuildinfo

# Credenciales descargadas de consolas (Google Cloud, etc.). Nunca al repo.
client_secret_*.json
*credentials*.json
*-key.json

# Configuracion local de herramientas: es de esta maquina, no del proyecto.
.claude/
.vercel/
