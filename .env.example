# PLANTILLA. Este archivo SI se versiona -> nunca poner secretos reales aqui.
# Copiar a .env (que esta en .gitignore) y llenar alla.

# --- Necesario para el Hito 0.5 ---

# Google Places API (New). Consola: https://console.cloud.google.com
#   1. Habilitar "Places API (New)" en la Biblioteca
#   2. Credenciales -> Crear credenciales -> Clave de API
#   3. Restringirla a "Places API (New)"
# OJO: Google exige una cuenta de facturacion conectada, aun para la capa gratis.
# NO sirve un cliente OAuth (client_id/client_secret): Places usa una API key.
GOOGLE_PLACES_API_KEY=

# Claude. Consola: https://console.anthropic.com -> API Keys
# Decision del jefe: usar la cuenta de project manager, ~$5 de credito.
ANTHROPIC_API_KEY=

# --- Necesario desde la Fase 0 (persistencia) ---

# Supabase -> Project Settings -> API. URL COMPLETA (https://<ref>.supabase.co)
SUPABASE_URL=

# Formato nuevo de llaves. sb_secret_ salta RLS -> SOLO servidor y scripts.
SUPABASE_SECRET_KEY=
# sb_publishable_ respeta RLS -> esta es la que va en el panel web (Fase 6).
SUPABASE_PUBLISHABLE_KEY=

# Proyectos viejos: el JWT largo de service_role. Se usa si SUPABASE_SECRET_KEY
# esta vacia. Con una de las dos alcanza.
SUPABASE_SERVICE_ROLE_KEY=

# Conexion a Postgres, solo para `npm run migrar`.
# Panel -> boton Connect -> pooler en modo SESION (puerto 5432), no el 6543.
# Incluye la contrasena de la base. Si no la recuerdas:
#   Project Settings -> Database -> Reset database password
DATABASE_URL=

# --- Fase 2 (bloqueado, esperando cuenta) ---
APIFY_TOKEN=

# --- Fase 3 ---
MILLIONVERIFIER_API_KEY=

# --- Fase 6 / 7 ---

# Quién sos mientras no haya login. Se usa para la auditoría de aprobaciones y
# el panel lo MUESTRA con un aviso, para que nadie confunda estos registros con
# los de una persona real.
USUARIO_DEV=

# Protege /api/cron. Esa ruta dispara trabajo que cuesta plata (Places, Claude,
# verificador): sin token, cualquiera con la URL podría vaciar el crédito.
# En producción es OBLIGATORIO — si falta, la ruta responde 500 y no corre nada
# (falla cerrado a propósito). En local con `npm run dev` no hace falta.
# Ponerlo también en las variables de entorno de Vercel.
CRON_SECRET=
